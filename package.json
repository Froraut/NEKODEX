{
  "name": "codex-chatgpt-web",
  "version": "6.1.33-nekodex.4",
  "publishedReleaseVersion": "6.1.33-nekodex.4",
  "publishedLinuxReleaseVersion": "6.1.12-nekodex.1",
  "private": true,
  "description": "NEKODEX — a desktop workspace for ChatGPT accounts, coding agents, and local tools.",
  "author": "FroRaut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Froraut/NEKODEX.git"
  },
  "homepage": "https://github.com/Froraut/NEKODEX#readme",
  "bugs": {
    "url": "https://github.com/Froraut/NEKODEX/issues"
  },
  "packageManager": "bun@1.4.3",
  "type": "module",
  "bin": {
    "codex-chatgpt-web": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES"
  ],
  "scripts": {
    "start": "bun run src/cli.ts serve",
    "setup": "bun run src/cli.ts setup",
    "doctor": "bun run src/cli.ts doctor",
    "dev:launcher": "bun run src/cli.ts dev launcher",
    "dev:chat": "bun run src/cli.ts dev chat",
    "audit": "bun audit",
    "check-version": "bun run scripts/check-version.ts",
    "typecheck": "bun x --no-install --bun tsc --noEmit",
    "architecture:check": "bun run scripts/architecture-map.ts --check",
    "architecture:update": "bun run scripts/architecture-map.ts --write",
    "connector-abi:check": "bun run scripts/connector-abi.ts --check",
    "connector-abi:write": "bun run scripts/connector-abi.ts --write",
    "licenses": "bun run scripts/generate-third-party-notices.ts --include-launcher",
    "clean": "bun run scripts/clean.ts",
    "build": "bun run scripts/build-runtime-bundle.ts",
    "smoke": "bun run scripts/smoke-release.ts dist/runtime",
    "smoke:codex": "bun run scripts/smoke-codex-catalog.ts",
    "smoke:cancel": "bun run scripts/smoke-codex-cancel.ts",
    "smoke:interrupt": "bun run scripts/smoke-codex-interrupt.ts",
    "smoke:subagents": "bun run scripts/smoke-codex-subagents.ts --v1 && bun run scripts/smoke-codex-subagents.ts --v2",
    "smoke:subagents:live": "bun run scripts/smoke-codex-web-subagents.ts",
    "launcher": "bun run scripts/start-launcher.ts",
    "app": "bun run scripts/start-launcher.ts",
    "app:package": "bun run --cwd launcher package",
    "app:smoke": "bun run --cwd launcher smoke:package",
    "launcher:dev": "bun run --cwd launcher dev",
    "launcher:audit": "bun run --cwd launcher audit",
    "launcher:typecheck": "bun run --cwd launcher typecheck",
    "launcher:build": "bun run --cwd launcher build",
    "verify": "bun run scripts/verify.ts",
    "test:regressions": "bun test tests/account-tunnel-supervision.test.ts tests/account-tunnel-dead-marker.test.ts tests/codex-chained-route.test.ts tests/reasoning-replay.test.ts tests/response-rebinding.test.ts tests/account-not-ready-replay.test.ts tests/tool-proof.test.ts tests/api-panel-google.test.ts tests/reply-alignment.test.ts tests/update-recheck.test.ts tests/boot-recovery.test.ts tests/unsent-turn-retry.test.ts tests/picker-surface-layout.test.ts tests/browser-diagnostic-cause.test.ts",
    "test:selective-adoption": "bun test tests/support-report.test.ts tests/support-report-sources.test.ts tests/task-observation.test.ts tests/task-center-overview.test.ts tests/settings-search.test.ts tests/update-authenticated-staging.test.ts",
    "test:tunnel-credentials": "bun test tests/tunnel-credentials.test.ts tests/tunnel-credential-cli.test.ts tests/electron-tunnel-credentials.test.ts",
    "vm:build:helper": "node scripts/build-execution-vm-helper.cjs --development",
    "vm:prepare:guest": "python3 scripts/prepare-execution-guest.py",
    "vm:dev": "bun run scripts/dev-execution-vm.ts"
  },
  "dependencies": {
    "@mixmark-io/domino": "2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@renovatebot/pep440": "5.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chromium-bidi": "158.0.8115-0",
    "fflate": "^0.8.3",
    "playwright-core": "^1.64.1",
    "tiktoken": "1.0.22",
    "toml-eslint-parser": "1.0.3",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/turndown": "5.0.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "zod-to-json-schema": "3.25.2"
  },
  "keywords": [
    "codex",
    "chatgpt",
    "responses-api",
    "mcp",
    "playwright"
  ],
  "license": "MIT"
}
