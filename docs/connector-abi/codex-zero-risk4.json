      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "patch": {
            "maxLength": 5000000,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "maxLength": 256,
            "minLength": 20,
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "patch"
        ],
        "type": "object"
      },
      "name": "codex_apply_patch",
      "outputSchema": null,
      "title": "Apply a native Codex patch"
    },
