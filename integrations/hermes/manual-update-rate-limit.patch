index 10aa82b948..afbf6a9eec 100644
--- a/apps/desktop/electron/update-api-check.ts
+++ b/apps/desktop/electron/update-api-check.ts
@@ -21,6 +21,30 @@ export const UPDATE_CHECK_TTL_MS = 24 * 60 * 60 * 1000
 // but never on every poller tick.
 export const UPDATE_CHECK_FAILURE_TTL_MS = 60 * 60 * 1000
 
+interface UpdateProbeResult {
+  error?: string
+  message?: string
+  apiStatus?: number
+  [key: string]: unknown
+}
+
+// Keep passive traffic API-only. An explicit check may recover from the public
+// API quota through a single ref query; it must never fetch a pack or invent a count.
+export async function checkWithManualRateLimitFallback(
+  force: boolean,
+  apiCheck: () => Promise<UpdateProbeResult>,
+  refCheck: () => Promise<UpdateProbeResult>
+): Promise<UpdateProbeResult> {
+  const api = await apiCheck()
+  if (!force || !api.error || ![403, 429].includes(api.apiStatus ?? 0)) {
+    return api
+  }
+  const fallback = await refCheck()
+  return fallback.error
+    ? { ...fallback, message: `${api.message} Git ref check: ${fallback.message}` }
+    : fallback
+}
+
 export interface CachedUpdateCheck {
   fetchedAt: number
   currentSha: string
