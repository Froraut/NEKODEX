+test('manual rate-limited checks can recover by ref without enabling passive Git polling', async () => {
+  const limited = { error: 'fetch-failed', apiStatus: 403, message: 'API quota exhausted' }
+  let refCalls = 0
+  const refCheck = async () => { refCalls++; return { behind: null, updateAvailable: true, targetSha: SHA_B } }
+  assert.deepEqual(await checkWithManualRateLimitFallback(false, async () => limited, refCheck), limited)
+  assert.equal(refCalls, 0)
+  assert.deepEqual(await checkWithManualRateLimitFallback(true, async () => limited, refCheck), {
+    behind: null, updateAvailable: true, targetSha: SHA_B
+  })
+  assert.equal(refCalls, 1)
+  const failed = await checkWithManualRateLimitFallback(true, async () => limited,
+    async () => ({ error: 'fetch-failed', message: 'Git offline' }))
+  assert.equal(failed.error, 'fetch-failed')
+  assert.match(failed.message ?? '', /API quota exhausted.*Git offline/)
+})
+
