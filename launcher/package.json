{
  "name": "codex-web-gpt-launcher",
  "version": "5.1.0-froraut.10",
  "private": true,
  "description": "FroRaut maintained fork of Codex ChatGPT Web desktop control center",
  "author": "FroRaut",
  "updateRepository": "Froraut/codex-chatgpt-web",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "bun run scripts/dev.cjs",
    "audit": "bun audit",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build": "bun run typecheck && bun run build:renderer",
    "build:runtime": "bun run scripts/prepare-runtime.cjs",
    "package": "bun run build && bun run build:runtime && bun run scripts/package.cjs",
    "package:mac": "bun run build && bun run build:runtime && bun run scripts/package.cjs --mac",
    "package:win": "bun run build && bun run build:runtime && bun run scripts/package.cjs --win",
    "package:linux": "bun run build && bun run build:runtime && bun run scripts/package.cjs --linux",
    "smoke:package": "bun run scripts/smoke-package.cjs",
    "test": "node --test tests/*.test.cjs",
    "start": "electron ."
  },
  "dependencies": {
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.10.7",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "dev.codexwebgpt.launcher",
    "productName": "Codex Web GPT",
    "artifactName": "codex-web-gpt-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/linux-appimage-runner.sh"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "assets/linux-appimage-runner.sh",
      "package.json",
      "release-trust.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signIgnore": [
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]runtime[/\\\\]bun$"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "CFBundleGetInfoString": "FroRaut maintained fork · replaces upstream compatibly"
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "signExts": [
        "!bun.exe"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "https://timestamp.digicert.com"
      }
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "guid": "d1a6026a-6210-588e-9a2b-da3936f94e02",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "copyright": "Copyright © FroRaut and upstream contributors"
  },
  "forkIdentity": {
    "publisher": "FroRaut",
    "repository": "Froraut/codex-chatgpt-web",
    "upstream": "miuuyy/codex-chatgpt-web",
    "installationMode": "replace-upstream",
    "profileCompatibility": "dev.codexwebgpt.launcher"
  }
}
