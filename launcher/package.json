{
  "name": "codex-web-gpt-launcher",
  "version": "6.1.32-nekodex.15",
  "private": true,
  "description": "NEKODEX \u2014 a desktop workspace for ChatGPT accounts, coding agents, and local tools.",
  "author": "FroRaut",
  "updateRepository": "Froraut/NEKODEX",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "bun run scripts/dev.cjs",
    "audit": "bun audit",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build": "bun run typecheck && bun run build:terminal && bun run build:renderer && bun run build:credential-helper && bun run build:oauth-vault-helper",
    "build:runtime": "bun run scripts/prepare-runtime.cjs",
    "package": "bun run build && bun run build:runtime && bun run scripts/package.cjs",
    "package:mac": "bun run build && bun run build:runtime && bun run scripts/package.cjs --mac",
    "package:win": "bun run build && bun run build:runtime && bun run scripts/package.cjs --win",
    "package:linux": "bun run build && bun run build:runtime && bun run scripts/package.cjs --linux",
    "smoke:package": "bun run scripts/smoke-package.cjs",
    "start": "electron .",
    "build:credential-helper": "node ../scripts/build-credential-helper.cjs --development",
    "build:oauth-vault-helper": "node ../scripts/build-oauth-vault-helper.cjs --development",
    "build:terminal": "node scripts/build-workspace-terminal.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xterm/xterm": "6.0.0",
    "motion": "^14.3.0",
    "node-pty": "1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-uri": "3.1.8",
    "http-cache-semantics": "4.3.0",
    "js-yaml": "4.3.2",
    "undici@6": "6.28.1",
    "undici@7": "7.29.1"
  },
  "build": {
    "appId": "dev.codexwebgpt.launcher",
    "productName": "NEKODEX",
    "artifactName": "codex-web-gpt-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "assets/linux-appimage-runner.sh",
      "electron/credential-helper/**",
      "electron/oauth-vault-helper/**",
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/desktop-helper/**",
      "!electron/skill-pdf-helper/**",
      "!electron/execution-vm-helper/**",
      "assets/icon.png",
      "assets/linux-appimage-runner.sh",
      "package.json",
      "release-trust.json",
      "assets/tray.svg",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signIgnore": [
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]runtime[/\\\\]bun$",
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]app\\.asar\\.unpacked[/\\\\]electron[/\\\\]credential-helper[/\\\\]darwin-(?:arm64|x64)[/\\\\]nekodex-credential-helper$",
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]app[/\\\\]credential-helper[/\\\\]darwin-(?:arm64|x64)[/\\\\]nekodex-credential-helper$",
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]app\\.asar\\.unpacked[/\\\\]electron[/\\\\]oauth-vault-helper[/\\\\]darwin-(?:arm64|x64)[/\\\\]nekodex-oauth-vault-helper$",
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]app[/\\\\]oauth-vault-helper[/\\\\]darwin-(?:arm64|x64)[/\\\\]nekodex-oauth-vault-helper$",
        "[/\\\\]Resources[/\\\\].*\\.(?:pak|ttf|woff2?|png|mp4|icns)$",
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]app[/\\\\]desktop-helper[/\\\\]darwin-(?:arm64|x64)[/\\\\]nekodex-desktop-helper$",
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]app[/\\\\]skill-pdf-helper[/\\\\]darwin-(?:arm64|x64)[/\\\\]nekodex-skill-pdf-helper$",
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]app[/\\\\]execution-vm[/\\\\]darwin-arm64[/\\\\]nekodex-execution-vm-helper$",
        "[/\\\\]Contents[/\\\\]Resources[/\\\\]runtime[/\\\\]app[/\\\\]owned-native[/\\\\]build[/\\\\](?:aarch64|x86_64)-apple-darwin[/\\\\]nekodex-owned-native-worker$"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "CFBundleGetInfoString": "NEKODEX by FroRaut"
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "signExts": [
        "!bun.exe"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "https://timestamp.digicert.com"
      }
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "guid": "d1a6026a-6210-588e-9a2b-da3936f94e02",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "copyright": "Copyright \u00a9 FroRaut and upstream contributors",
    "dmg": {
      "artifactName": "NEKODEX-${version}-mac-${arch}.${ext}",
      "title": "NEKODEX ${version}"
    }
  },
  "forkIdentity": {
    "publisher": "FroRaut",
    "repository": "Froraut/NEKODEX",
    "upstream": "miuuyy/codex-chatgpt-web",
    "installationMode": "replace-upstream",
    "profileCompatibility": "dev.codexwebgpt.launcher",
    "displayName": "NEKODEX"
  }
}
